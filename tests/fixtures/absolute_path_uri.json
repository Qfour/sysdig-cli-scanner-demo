{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "sysdig-cli-scanner",
          "version": "1.29.0",
          "rules": [
            {
              "id": "openssl-1.1.1-usr/lib/x86_64-linux-gnu",
              "name": "openssl@1.1.1",
              "shortDescription": { "text": "1 vulnerability found in openssl@1.1.1" },
              "properties": { "security-severity": "9.1" }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "openssl-1.1.1-usr/lib/x86_64-linux-gnu",
          "level": "error",
          "message": { "text": "CVE-2022-0000 in openssl@1.1.1" },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "/usr/lib/x86_64-linux-gnu/libssl.so.1.1"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
